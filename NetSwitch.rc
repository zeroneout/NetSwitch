#include <windows.h>

1 ICON "NetSwitch.ico"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "NetSwitch - one click wired / wireless switcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "NetSwitch"
            VALUE "OriginalFilename", "NetSwitch.exe"
            VALUE "ProductName", "NetSwitch"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
